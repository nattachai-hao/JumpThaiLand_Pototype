generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Scenario {
  CAFE
  TRAVEL
  INTERVIEW
  DINNER
  MEETING
  DIRECTIONS
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  scenario    Scenario
  status      ConversationStatus @default(ACTIVE)
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")
  messages    Message[]
  feedback    Feedback?
  flashcards  Flashcard[]

  @@index([startedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Feedback {
  id                 String       @id @default(uuid()) @db.Uuid
  conversationId     String       @unique @map("conversation_id") @db.Uuid
  grammarScore       Int          @map("grammar_score")
  vocabularyScore    Int          @map("vocabulary_score")
  communicationScore Int          @map("communication_score")
  summary            String
  corrections        Json
  createdAt          DateTime     @default(now()) @map("created_at")
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Flashcard {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  word           String
  meaningTh      String       @map("meaning_th")
  example        String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("flashcards")
}

model DailyReward {
  id        String   @id @default(uuid()) @db.Uuid
  day       String   @unique
  points    Int
  claimedAt DateTime @default(now()) @map("claimed_at")

  @@map("daily_rewards")
}
